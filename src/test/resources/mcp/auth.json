{
  "info": { "name": "secure-server", "version": "1.0.0" },
  "auth": {
    "issuer": "{{test.issuer}}",
    "audience": "mcp-test",
    "scopes": ["mcp"]
  },
  "tools": {
    "headers": {
      "route": "direct:headers",
      "description": "Returns the Mcp headers it received",
      "inputSchema": { "type": "object" }
    },
    "admin": {
      "route": "direct:headers",
      "description": "Needs the admin scope",
      "inputSchema": { "type": "object" },
      "scopes": ["admin"]
    }
  }
}
